{
  "name": "playwright-session-kit",
  "version": "1.0.0",
  "description": "Reusable Playwright + TypeScript setup with persistent login-session management. Clone it, drop it into any project, and reuse authenticated sessions across test runs.",
  "private": true,
  "license": "MIT",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "postinstall": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@types/node": "^22.5.0",
    "dotenv": "^16.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
