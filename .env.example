# Copy this file to .env and fill in what you know.

# Base URL of the app under test. Required - there's no interactive prompt
# fallback for it, so tests fail fast with a clear error if it's missing.
BASE_URL=

# Optional - login is a one-time manual step (see helpers/auth-setup.ts);
# once .auth/<key>.session.json is saved it's reused forever (delete it
# yourself to force a re-login). Set BOTH of these to have the login form
# filled in and submitted automatically; leave EITHER one blank and neither
# field gets pre-filled - you type both in and submit by hand.
LOGIN_USERNAME=
LOGIN_PASSWORD=""

# Distinguishes multiple saved sessions (e.g. different roles/users) so
# logging in as a different account doesn't clobber another saved session.
SESSION_KEY=default

# Set to 1 on CI - Playwright then retries failed tests and adds the GitHub
# reporter (see playwright.config.ts). Unrelated to login, which is always
# manual regardless of this setting.
CI=
