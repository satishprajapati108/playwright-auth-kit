# Copy this file to .env and fill in what you know.
# Anything left blank will be prompted for interactively on the first run
# (when not running in CI) and offered back to you to save into .env.

# Base URL of the app under test. Required.
BASE_URL=

# Login credentials. Optional here - if left blank you will be prompted
# in the terminal the first time a session needs to be created.
USERNAME=
PASSWORD=

# The login form's locators live directly in pages/login.page.ts as
# data-testid Locators - edit that file for your app (path, testids,
# SSO/MFA/multi-step flows), there's nothing to configure here.

# How long a saved session is trusted before we log in again, in hours.
SESSION_MAX_AGE_HOURS=8

# Hard cutoff: a saved session untouched for this many days is deleted
# outright and a fresh login is forced, regardless of SESSION_MAX_AGE_HOURS.
SESSION_TTL_DAYS=7

# If login fails this many times in a row for the same SESSION_KEY, the
# stale session file is automatically wiped so the next run starts clean.
LOGIN_FAILURE_THRESHOLD=3

# Distinguishes multiple saved sessions (e.g. different roles/users) so
# switching USERNAME doesn't clobber another user's saved session.
SESSION_KEY=default

# Set to 1 on CI so the framework never tries to prompt for input and
# instead fails fast with a clear error if credentials are missing.
CI=
